<!-- ================== CONTACT STYLES ================== -->
<style>
    /* ===== HERO ===== */
    .contact-hero {
        background: linear-gradient(135deg, #111827 0%, #374151 100%);
        color: var(--white);
        padding: 70px 16px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .contact-hero::before {
        content: "";
        position: absolute;
        right: -100px;
        top: -100px;
        width: 350px;
        height: 350px;
        background: var(--accent);
        border-radius: 50%;
        opacity: 0.12;
    }

    .contact-hero-inner {
        max-width: 800px;
        margin: 0 auto;
        position: relative;
        z-index: 2;
    }

    .contact-hero .tag {
        display: inline-block;
        background: rgba(255, 107, 0, 0.15);
        color: var(--accent);
        padding: 6px 16px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 18px;
        letter-spacing: 0.5px;
    }

    .contact-hero h1 {
        font-size: 42px;
        font-weight: 800;
        line-height: 1.15;
        margin-bottom: 16px;
        letter-spacing: -1px;
    }

    .contact-hero h1 span { color: var(--accent); }

    .contact-hero p {
        font-size: 16px;
        color: #d1d5db;
        max-width: 620px;
        margin: 0 auto;
        line-height: 1.7;
    }

    /* ===== BREADCRUMB ===== */
    .breadcrumb {
        max-width: 1200px;
        margin: 0 auto;
        padding: 18px 16px 0;
        font-size: 13px;
        color: var(--gray);
    }

    .breadcrumb a:hover { color: var(--accent); }

    /* ===== CONTACT CARDS ===== */
    .contact-cards {
        max-width: 1200px;
        margin: -40px auto 0;
        padding: 0 16px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        position: relative;
        z-index: 5;
    }

    .contact-card {
        background: var(--white);
        border-radius: 14px;
        padding: 24px 20px;
        text-align: center;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.07);
        border: 1px solid var(--border);
        transition: all 0.25s ease;
    }

    .contact-card:hover {
        transform: translateY(-5px);
        border-color: var(--accent);
    }

    .contact-card .cc-icon {
        width: 56px;
        height: 56px;
        background: linear-gradient(135deg, rgba(255, 107, 0, 0.12), rgba(255, 107, 0, 0.05));
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin: 0 auto 14px;
    }

    .contact-card h4 {
        font-size: 15px;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 6px;
    }

    .contact-card p {
        font-size: 13px;
        color: var(--gray);
        line-height: 1.6;
    }

    .contact-card a {
        font-size: 13px;
        color: var(--accent);
        font-weight: 600;
        display: inline-block;
        margin-top: 6px;
    }

    .contact-card a:hover { text-decoration: underline; }

    /* ===== MAIN ===== */
    .contact-main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 70px 16px 60px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: start;
    }

    /* ===== FORM CARD ===== */
    .form-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.04);
    }

    .form-card h2 {
        font-size: 22px;
        font-weight: 800;
        color: var(--primary);
        margin-bottom: 6px;
        letter-spacing: -0.4px;
    }

    .form-card h2 span { color: var(--accent); }

    .form-card .sub {
        font-size: 13.5px;
        color: var(--gray);
        margin-bottom: 24px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        margin-bottom: 16px;
    }

    .form-group label {
        font-size: 13px;
        font-weight: 600;
        color: var(--primary);
        margin-bottom: 7px;
    }

    .form-group label .req { color: var(--danger); }

    .form-group input,
    .form-group textarea,
    .form-group select {
        padding: 12px 14px;
        border: 1.5px solid var(--border);
        border-radius: 8px;
        font-size: 14px;
        color: var(--primary);
        background: var(--white);
        transition: border-color 0.2s ease;
        font-family: inherit;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
        border-color: var(--accent);
        outline: none;
    }

    .form-group textarea {
        resize: vertical;
        min-height: 130px;
    }

    .form-group .error-msg {
        font-size: 12px;
        color: var(--danger);
        margin-top: 4px;
        display: none;
    }

    .form-group.error input,
    .form-group.error textarea,
    .form-group.error select {
        border-color: var(--danger);
    }

    .form-group.error .error-msg { display: block; }

    /* ===== SUBMIT ===== */
    .contact-submit {
        width: 100%;
        padding: 14px;
        background: var(--accent);
        color: var(--white);
        border-radius: 10px;
        font-size: 15px;
        font-weight: 700;
        transition: background 0.2s ease;
        margin-top: 6px;
    }

    .contact-submit:hover:not(:disabled) {
        background: var(--accent-hover);
    }

    .contact-submit:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    /* ===== SUCCESS ===== */
    .form-success {
        display: none;
        text-align: center;
        padding: 40px 20px;
    }

    .form-success.show { display: block; }

    .form-success .icon {
        width: 80px;
        height: 80px;
        background: #d1fae5;
        color: var(--success);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        margin: 0 auto 18px;
    }

    .form-success h3 {
        font-size: 20px;
        color: var(--primary);
        margin-bottom: 8px;
    }

    .form-success p {
        font-size: 14px;
        color: var(--gray);
        margin-bottom: 20px;
        line-height: 1.6;
    }

    .form-success button {
        padding: 11px 24px;
        background: var(--primary);
        color: var(--white);
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
    }

    .form-success button:hover { background: var(--accent); }

    /* ===== INFO SIDE ===== */
    .info-side {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .info-block {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 26px;
    }

    .info-block h3 {
        font-size: 17px;
        font-weight: 800;
        color: var(--primary);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: -0.3px;
    }

    .info-block h3 span { color: var(--accent); }

    .info-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .info-list li {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        font-size: 14px;
        color: #4b5563;
        line-height: 1.6;
    }

    .info-list li .icon {
        font-size: 18px;
        flex-shrink: 0;
        margin-top: 1px;
    }

    .info-list li strong {
        color: var(--primary);
        font-weight: 700;
        display: block;
        margin-bottom: 2px;
        font-size: 13.5px;
    }

    /* ===== HOURS ===== */
    .hours-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .hours-list li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13.5px;
        padding: 9px 0;
        border-bottom: 1px dashed var(--border);
    }

    .hours-list li:last-child { border-bottom: none; }

    .hours-list li span:first-child {
        color: var(--primary);
        font-weight: 600;
    }

    .hours-list li span:last-child {
        color: var(--gray);
    }

    .hours-list li.closed span:last-child {
        color: var(--danger);
        font-weight: 600;
    }

    .hours-list li.open-now span:last-child {
        color: var(--success);
        font-weight: 600;
    }

    /* ===== MAP / VISUAL ===== */
    .map-block {
        background: linear-gradient(135deg, #111827 0%, #374151 100%);
        color: var(--white);
        border-radius: 14px;
        padding: 40px 26px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .map-block::after {
        content: "";
        position: absolute;
        left: -60px;
        bottom: -60px;
        width: 200px;
        height: 200px;
        background: var(--accent);
        border-radius: 50%;
        opacity: 0.15;
    }

    .map-block .map-icon {
        font-size: 60px;
        margin-bottom: 12px;
        position: relative;
        z-index: 2;
    }

    .map-block h4 {
        font-size: 18px;
        font-weight: 800;
        margin-bottom: 6px;
        position: relative;
        z-index: 2;
    }

    .map-block p {
        font-size: 13.5px;
        color: #d1d5db;
        margin-bottom: 18px;
        position: relative;
        z-index: 2;
        line-height: 1.6;
    }

    .map-block a {
        position: relative;
        z-index: 2;
        display: inline-block;
        background: var(--accent);
        color: var(--white);
        padding: 11px 22px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        transition: background 0.2s ease;
    }

    .map-block a:hover { background: var(--accent-hover); }

    /* ===== SOCIALS ===== */
    .socials-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 4px;
    }

    .socials-row a {
        flex: 1;
        min-width: 110px;
        padding: 12px 14px;
        background: var(--light);
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        color: var(--primary);
        text-align: center;
        transition: all 0.2s ease;
    }

    .socials-row a:hover {
        background: var(--accent);
        color: var(--white);
        transform: translateY(-2px);
    }

    /* ===== TOAST ===== */
    .toast {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%) translateY(100px);
        background: var(--primary);
        color: var(--white);
        padding: 14px 24px;
        border-radius: 30px;
        font-size: 14px;
        font-weight: 600;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        z-index: 9999;
        opacity: 0;
        transition: all 0.35s ease;
    }

    .toast.show {
        transform: translateX(-50%) translateY(0);
        opacity: 1;
    }

    .toast.success { background: var(--success); }
    .toast.error { background: var(--danger); }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 1000px) {
        .contact-cards { grid-template-columns: repeat(2, 1fr); margin-top: 24px; }
        .contact-main { grid-template-columns: 1fr; gap: 30px; }
        .contact-hero h1 { font-size: 32px; }
    }

    @media (max-width: 600px) {
        .contact-hero { padding: 50px 16px; }
        .contact-hero h1 { font-size: 24px; }
        .contact-main { padding: 40px 16px; }
        .form-card { padding: 24px 20px; }
        .form-card h2 { font-size: 19px; }
        .contact-cards { grid-template-columns: 1fr; }
    }
</style>

