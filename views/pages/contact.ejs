<!-- ================== FIRESTORE: CONTACT LOGIC ================== -->
<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import {
        getFirestore,
        collection,
        addDoc,
        serverTimestamp
    } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

    // Your web app's Firebase configuration
    const firebaseConfig = {
        apiKey: "AIzaSyC-8IRm50zrlHWjG-jpfzrh0YtprC1Tsaw",
        authDomain: "product-store-6a651.firebaseapp.com",
        projectId: "product-store-6a651",
        storageBucket: "product-store-6a651.firebasestorage.app",
        messagingSenderId: "379449735108",
        appId: "1:379449735108:web:bf0bb51d68f28273cdd691"
    };

    // Initialize Firebase
    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);

    // ===== SHOW TOAST =====
    function showToast(msg, type = 'success') {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.className = 'toast show ' + type;
        setTimeout(() => {
            t.className = 'toast ' + type;
        }, 3000);
    }

    // ===== EMAIL REGEX =====
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    // ===== CLEAR ERROR ON INPUT =====
    ['cName', 'cEmail', 'cPhone', 'cSubject', 'cMessage'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener('input', () => {
                const g = el.closest('.form-group');
                if (g) g.classList.remove('error');
            });
            el.addEventListener('change', () => {
                const g = el.closest('.form-group');
                if (g) g.classList.remove('error');
            });
        }
    });

    function setError(groupId) {
        const g = document.getElementById(groupId);
        if (g) g.classList.add('error');
    }

    // ===== VALIDATE =====
    function validate() {
        let valid = true;

        const name = document.getElementById('cName').value.trim();
        const email = document.getElementById('cEmail').value.trim();
        const phone = document.getElementById('cPhone').value.trim();
        const subject = document.getElementById('cSubject').value;
        const message = document.getElementById('cMessage').value.trim();

        document.querySelectorAll('.form-group').forEach(g => g.classList.remove('error'));

        if (!name) { setError('cNameGroup'); valid = false; }
        if (!email || !EMAIL_RE.test(email)) { setError('cEmailGroup'); valid = false; }
        if (phone && !/^[0-9+\s-]{9,15}$/.test(phone)) { setError('cPhoneGroup'); valid = false; }
        if (!subject) { setError('cSubjectGroup'); valid = false; }
        if (!message || message.length < 5) { setError('cMessageGroup'); valid = false; }

        return valid;
    }

    // ===== SUBMIT FORM =====
    document.getElementById('contactForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        if (!validate()) {
            showToast('⚠️ Tafadhali jaza fomu kwa usahihi', 'error');
            const firstErr = document.querySelector('.form-group.error');
            if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
        }

        const btn = document.getElementById('contactSubmitBtn');
        btn.disabled = true;
        btn.textContent = '⏳ Inatuma...';

        const data = {
            name: document.getElementById('cName').value.trim(),
            email: document.getElementById('cEmail').value.trim(),
            phone: document.getElementById('cPhone').value.trim(),
            subject: document.getElementById('cSubject').value,
            message: document.getElementById('cMessage').value.trim(),
            status: 'new', // new | read | replied
            createdAt: serverTimestamp()
        };

        try {
            await addDoc(collection(db, 'messages'), data);

            // Show success
            document.getElementById('contactForm').style.display = 'none';
            document.getElementById('formSuccess').classList.add('show');

            showToast('✅ Ujumbe wako umetumwa kikamilifu!', 'success');

            window.scrollTo({ top: 0, behavior: 'smooth' });

        } catch (err) {
            console.error('Kosa la kutuma ujumbe:', err);
            showToast('❌ Imeshindikana kutuma ujumbe. Jaribu tena.', 'error');
            btn.disabled = false;
            btn.textContent = '📤 Tuma Ujumbe';
        }
    });

    // ===== RESET FORM =====
    window.resetForm = function () {
        document.getElementById('contactForm').reset();
        document.getElementById('contactForm').style.display = 'block';
        document.getElementById('formSuccess').classList.remove('show');

        const btn = document.getElementById('contactSubmitBtn');
        btn.disabled = false;
        btn.textContent = '📤 Tuma Ujumbe';
    };
</script>

