<%- include('../partials/header', { title: 'Kikapu Changu' }) %>
<%- include('../partials/navbar', { currentPage: 'cart' }) %>

<main>

<!-- ================== CART STYLES ================== -->
<style>
    /* ===== PAGE HEADER ===== */
    .cart-header {
        background: linear-gradient(135deg, #111827 0%, #374151 100%);
        color: var(--white);
        padding: 40px 16px;
        text-align: center;
    }

    .cart-header h1 {
        font-size: 30px;
        font-weight: 800;
        letter-spacing: -0.5px;
        margin-bottom: 6px;
    }

    .cart-header h1 span { color: var(--accent); }

    .cart-header p {
        font-size: 14px;
        color: #d1d5db;
    }

    /* ===== CART WRAPPER ===== */
    .cart-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 16px;
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 30px;
        align-items: start;
    }

    /* ===== CART ITEMS ===== */
    .cart-items {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
    }

    .cart-items-head {
        padding: 18px 22px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }

    .cart-items-head h2 {
        font-size: 18px;
        font-weight: 700;
        color: var(--primary);
    }

    .cart-items-head .count {
        font-size: 13px;
        color: var(--gray);
    }

    .clear-cart-btn {
        font-size: 13px;
        color: var(--danger);
        font-weight: 600;
        background: transparent;
        padding: 6px 12px;
        border-radius: 6px;
        transition: background 0.2s ease;
    }

    .clear-cart-btn:hover {
        background: #fee2e2;
    }

    /* ===== ITEM ===== */
    .cart-item {
        display: grid;
        grid-template-columns: 100px 1fr auto;
        gap: 16px;
        padding: 20px 22px;
        border-bottom: 1px solid var(--border);
        align-items: center;
    }

    .cart-item:last-child { border-bottom: none; }

    .cart-item-image {
        width: 100px;
        height: 100px;
        background: var(--light);
        border-radius: 10px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid var(--border);
    }

    .cart-item-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .cart-item-image .placeholder {
        font-size: 44px;
        color: #9ca3af;
    }

    .cart-item-info h3 {
        font-size: 15.5px;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 6px;
        line-height: 1.3;
    }

    .cart-item-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 8px;
    }

    .cart-item-meta span {
        font-size: 12px;
        background: var(--light);
        padding: 3px 10px;
        border-radius: 20px;
        color: var(--gray);
    }

    .cart-item-price {
        font-size: 14px;
        color: var(--gray);
    }

    .cart-item-price strong {
        color: var(--primary);
        font-weight: 700;
    }

    /* ===== QTY ===== */
    .cart-item-controls {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 12px;
    }

    .cart-qty {
        display: flex;
        align-items: center;
        border: 1.5px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
    }

    .cart-qty button {
        width: 34px;
        height: 36px;
        background: var(--white);
        font-size: 16px;
        font-weight: 700;
        color: var(--primary);
        transition: background 0.2s ease;
    }

    .cart-qty button:hover {
        background: var(--light);
    }

    .cart-qty input {
        width: 44px;
        height: 36px;
        text-align: center;
        border: none;
        border-left: 1.5px solid var(--border);
        border-right: 1.5px solid var(--border);
        font-size: 14px;
        font-weight: 700;
    }

    .cart-item-subtotal {
        font-size: 16px;
        font-weight: 800;
        color: var(--accent);
    }

    .cart-remove-btn {
        font-size: 12.5px;
        color: var(--danger);
        background: transparent;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 4px;
        transition: background 0.2s ease;
    }

    .cart-remove-btn:hover {
        background: #fee2e2;
    }

    /* ===== SUMMARY ===== */
    .cart-summary {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 24px;
        position: sticky;
        top: 90px;
    }

    .cart-summary h3 {
        font-size: 17px;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 18px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--border);
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        font-size: 14px;
        color: var(--gray);
    }

    .summary-row strong {
        color: var(--primary);
        font-weight: 700;
    }

    .summary-row.free strong {
        color: var(--success);
    }

    .summary-divider {
        height: 1px;
        background: var(--border);
        margin: 16px 0;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .summary-total span:first-child {
        font-size: 15px;
        font-weight: 700;
        color: var(--primary);
    }

    .summary-total span:last-child {
        font-size: 24px;
        font-weight: 800;
        color: var(--accent);
    }

    .checkout-btn {
        display: block;
        width: 100%;
        padding: 14px;
        background: var(--accent);
        color: var(--white);
        border-radius: 10px;
        font-size: 15px;
        font-weight: 700;
        text-align: center;
        transition: background 0.2s ease;
        margin-bottom: 10px;
    }

    .checkout-btn:hover {
        background: var(--accent-hover);
    }

    .continue-btn {
        display: block;
        width: 100%;
        padding: 12px;
        background: transparent;
        color: var(--primary);
        border: 1.5px solid var(--border);
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        text-align: center;
        transition: all 0.2s ease;
    }

    .continue-btn:hover {
        border-color: var(--primary);
    }

    .summary-note {
        font-size: 12px;
        color: var(--gray);
        text-align: center;
        margin-top: 14px;
        line-height: 1.6;
    }

    /* ===== EMPTY CART ===== */
    .cart-empty {
        max-width: 520px;
        margin: 60px auto;
        padding: 50px 30px;
        text-align: center;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 14px;
    }

    .cart-empty .icon {
        font-size: 76px;
        display: block;
        margin-bottom: 14px;
    }

    .cart-empty h2 {
        font-size: 22px;
        color: var(--primary);
        margin-bottom: 8px;
    }

    .cart-empty p {
        color: var(--gray);
        margin-bottom: 22px;
        font-size: 14.5px;
    }

    /* ===== LOADING ===== */
    .cart-loading {
        text-align: center;
        padding: 80px 20px;
        color: var(--gray);
    }

    .cart-loading .spinner {
        margin: 0 auto 16px;
    }

    /* ===== TOAST ===== */
    .toast {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%) translateY(100px);
        background: var(--primary);
        color: var(--white);
        padding: 14px 24px;
        border-radius: 30px;
        font-size: 14px;
        font-weight: 600;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        z-index: 9999;
        opacity: 0;
        transition: all 0.35s ease;
    }

    .toast.show {
        transform: translateX(-50%) translateY(0);
        opacity: 1;
    }

    .toast.success { background: var(--success); }
    .toast.error { background: var(--danger); }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 900px) {
        .cart-wrapper {
            grid-template-columns: 1fr;
            padding: 24px 16px;
        }
        .cart-summary { position: static; }
    }

    @media (max-width: 600px) {
        .cart-item {
            grid-template-columns: 80px 1fr;
            gap: 12px;
            padding: 16px;
        }
        .cart-item-image { width: 80px; height: 80px; }
        .cart-item-controls {
            grid-column: 1 / -1;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }
        .cart-item-subtotal { font-size: 15px; }
    }
</style>

<!-- ================== PAGE HEADER ================== -->
<section class="cart-header">
    <h1>🛒 Kikapu <span>Changu</span></h1>
    <p>Angalia bidhaa zako kabla ya kuagiza</p>
</section>

<!-- ================== CART CONTAINER ================== -->
<div id="cartContainer">
    <div class="cart-loading">
        <div class="spinner"></div>
        <p>Inapakia kikapu...</p>
    </div>
</div>

</main>

<!-- ================== TOAST ================== -->
<div class="toast" id="toast"></div>

<!-- ================== FIRESTORE: CART LOGIC ================== -->
<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import {
        getFirestore,
        doc,
        getDoc,
        setDoc,
        serverTimestamp
    } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

    // Your web app's Firebase configuration
    const firebaseConfig = {
        apiKey: "AIzaSyC-8IRm50zrlHWjG-jpfzrh0YtprC1Tsaw",
        authDomain: "product-store-6a651.firebaseapp.com",
        projectId: "product-store-6a651",
        storageBucket: "product-store-6a651.firebasestorage.app",
        messagingSenderId: "379449735108",
        appId: "1:379449735108:web:bf0bb51d68f28273cdd691"
    };

    // Initialize Firebase
    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);

    // ===== STATE =====
    let cartItems = [];
    let guestId = null;

    // ===== GET GUEST ID =====
    function getGuestId() {
        let gid = localStorage.getItem('guestId');
        if (!gid) {
            gid = 'guest_' + Math.random().toString(36).substring(2, 12) + Date.now();
            localStorage.setItem('guestId', gid);
        }
        return gid;
    }

    // ===== FORMAT PRICE =====
    function formatPrice(value) {
        const num = Number(value) || 0;
        return 'TZS ' + num.toLocaleString('en-US');
    }

    // ===== SHOW TOAST =====
    function showToast(msg, type = 'success') {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.className = 'toast show ' + type;
        setTimeout(() => {
            t.className = 'toast ' + type;
        }, 2800);
    }

    // ===== UPDATE NAVBAR CART COUNT =====
    function updateNavCount() {
        const totalQty = cartItems.reduce((sum, i) => sum + (Number(i.quantity) || 0), 0);
        const badges = document.querySelectorAll('.icon-badge');
        badges.forEach(b => b.textContent = totalQty);
    }

    // ===== CALCULATE TOTALS =====
    function calcTotals() {
        const subtotal = cartItems.reduce((sum, i) => {
            return sum + (Number(i.price) || 0) * (Number(i.quantity) || 0);
        }, 0);
        const shippingFee = subtotal >= 100000 || subtotal === 0 ? 0 : 5000;
        const total = subtotal + shippingFee;
        const totalQty = cartItems.reduce((sum, i) => sum + (Number(i.quantity) || 0), 0);
        return { subtotal, shippingFee, total, totalQty };
    }

    // ===== RENDER EMPTY =====
    function renderEmpty() {
        document.getElementById('cartContainer').innerHTML = `
            <div class="cart-empty">
                <span class="icon">🛒</span>
                <h2>Kikapu chako ni kitupu</h2>
                <p>Hakuna bidhaa yoyote kwenye kikapu chako. Anza kununua sasa!</p>
                <a href="/shop" class="btn btn-primary">🛍️ Nenda Dukani</a>
            </div>
        `;
    }

    // ===== RENDER CART =====
    function renderCart() {
        if (cartItems.length === 0) {
            renderEmpty();
            updateNavCount();
            return;
        }

        const { subtotal, shippingFee, total, totalQty } = calcTotals();

        let itemsHtml = '';
        cartItems.forEach((item, idx) => {
            const imgHtml = item.image
                ? `<img src="${item.image}" alt="${item.name}">`
                : `<div class="placeholder">👕</div>`;

            const sizeMeta = item.size ? `<span>Ukubwa: ${item.size}</span>` : '';
            const colorMeta = item.color ? `<span>Rangi: ${item.color}</span>` : '';

            const itemSubtotal = (Number(item.price) || 0) * (Number(item.quantity) || 0);

            itemsHtml += `
                <div class="cart-item" data-idx="${idx}">
                    <div class="cart-item-image">${imgHtml}</div>

                    <div class="cart-item-info">
                        <h3>${item.name || 'Bidhaa'}</h3>
                        <div class="cart-item-meta">
                            ${sizeMeta}
                            ${colorMeta}
                        </div>
                        <div class="cart-item-price">
                            Bei: <strong>${formatPrice(item.price)}</strong>
                        </div>
                    </div>

                    <div class="cart-item-controls">
                        <div class="cart-qty">
                            <button data-action="minus" data-idx="${idx}">−</button>
                            <input type="number" value="${item.quantity}" min="1"
                                   data-action="input" data-idx="${idx}">
                            <button data-action="plus" data-idx="${idx}">+</button>
                        </div>
                        <div class="cart-item-subtotal">${formatPrice(itemSubtotal)}</div>
                        <button class="cart-remove-btn" data-action="remove" data-idx="${idx}">
                            🗑️ Ondoa
                        </button>
                    </div>
                </div>
            `;
        });

        const shippingText = shippingFee === 0
            ? `<span style="color:var(--success);font-weight:700;">BURE</span>`
            : `<strong>${formatPrice(shippingFee)}</strong>`;

        const freeMsg = subtotal < 100000 && subtotal > 0
            ? `<p style="font-size:12px;color:var(--gray);margin-top:-6px;margin-bottom:12px;">Ongeza ${formatPrice(100000 - subtotal)} upate usafirishaji BURE</p>`
            : '';

        document.getElementById('cartContainer').innerHTML = `
            <div class="cart-wrapper">
                <div class="cart-items">
                    <div class="cart-items-head">
                        <div>
                            <h2>Bidhaa Zangu</h2>
                            <div class="count">${totalQty} bidhaa kwenye kikapu</div>
                        </div>
                        <button class="clear-cart-btn" id="clearCartBtn">🗑️ Ondoa Zote</button>
                    </div>
                    ${itemsHtml}
                </div>

                <div class="cart-summary">
                    <h3>Muhtasari wa Oda</h3>

                    <div class="summary-row">
                        <span>Jumla ndogo (${totalQty} bidhaa)</span>
                        <strong>${formatPrice(subtotal)}</strong>
                    </div>

                    <div class="summary-row ${shippingFee === 0 ? 'free' : ''}">
                        <span>Usafirishaji</span>
                        ${shippingText}
                    </div>

                    ${freeMsg}

                    <div class="summary-divider"></div>

                    <div class="summary-total">
                        <span>JUMLA KUU</span>
                        <span>${formatPrice(total)}</span>
                    </div>

                    <a href="/checkout" class="checkout-btn">💳 Endelea na Malipo</a>
                    <a href="/shop" class="continue-btn">← Endelea Kununua</a>

                    <p class="summary-note">
                        🔒 Malipo salama — Cash on Delivery<br>
                        🚚 Usafirishaji bure kwa oda zaidi ya TZS 100,000
                    </p>
                </div>
            </div>
        `;

        attachEvents();
        updateNavCount();
    }

    // ===== SAVE CART TO FIRESTORE =====
    async function saveCart() {
        try {
            const cartRef = doc(db, 'carts', guestId);
            await setDoc(cartRef, {
                items: cartItems,
                guestId,
                updatedAt: serverTimestamp()
            }, { merge: true });
        } catch (err) {
            console.error('Kosa la kuhifadhi kikapu:', err);
            showToast('❌ Imeshindikana kuhifadhi mabadiliko', 'error');
        }
    }

    // ===== ATTACH EVENTS =====
    function attachEvents() {
        // Qty buttons
        document.querySelectorAll('.cart-qty button').forEach(btn => {
            btn.addEventListener('click', async () => {
                const idx = parseInt(btn.dataset.idx);
                const action = btn.dataset.action;

                if (action === 'minus') {
                    if (cartItems[idx].quantity > 1) {
                        cartItems[idx].quantity -= 1;
                    } else {
                        cartItems.splice(idx, 1);
                    }
                } else if (action === 'plus') {
                    cartItems[idx].quantity += 1;
                }

                await saveCart();
                renderCart();
            });
        });

        // Qty input change
        document.querySelectorAll('.cart-qty input').forEach(inp => {
            inp.addEventListener('change', async () => {
                const idx = parseInt(inp.dataset.idx);
                let v = parseInt(inp.value) || 1;
                if (v < 1) v = 1;
                if (v > 99) v = 99;
                cartItems[idx].quantity = v;
                await saveCart();
                renderCart();
            });
        });

        // Remove
        document.querySelectorAll('.cart-remove-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const idx = parseInt(btn.dataset.idx);
                const name = cartItems[idx].name;
                cartItems.splice(idx, 1);
                await saveCart();
                renderCart();
                showToast(`✅ "${name}" imeondolewa`, 'success');
            });
        });

        // Clear all
        const clearBtn = document.getElementById('clearCartBtn');
        if (clearBtn) {
            clearBtn.addEventListener('click', async () => {
                if (!confirm('Una uhakika unataka kuondoa bidhaa zote?')) return;
                cartItems = [];
                await saveCart();
                renderCart();
                showToast('🗑️ Kikapu kimeondolewa', 'success');
            });
        }
    }

    // ===== LOAD CART FROM FIRESTORE =====
    async function loadCart() {
        guestId = getGuestId();

        try {
            const cartRef = doc(db, 'carts', guestId);
            const snap = await getDoc(cartRef);

            if (snap.exists()) {
                cartItems = snap.data().items || [];
            } else {
                cartItems = [];
            }

            renderCart();

        } catch (err) {
            console.error('Kosa la kupakia kikapu:', err);
            document.getElementById('cartContainer').innerHTML = `
                <div class="cart-empty">
                    <span class="icon">⚠️</span>
                    <h2>Imeshindikana kupakia kikapu</h2>
                    <p>${err.message}</p>
                    <a href="/shop" class="btn btn-primary">Rudi Dukani</a>
                </div>
            `;
        }
    }

    loadCart();
</script>

<%- include('../partials/footer') %>
