            </li>
            <li>
                <a href="/admin/categories" class="<%= adminPage === 'categories' ? 'active' : '' %>">
                    <span class="icon">🏷️</span> Aina za Nguo
                </a>
            </li>
            <li>
                <a href="/admin/settings" class="<%= adminPage === 'settings' ? 'active' : '' %>">
                    <span class="icon">⚙️</span> Mipangilio
                </a>
            </li>
            <li>
                <a href="/" target="_blank">
