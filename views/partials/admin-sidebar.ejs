                </a>
            </li>
        </ul>

        <!-- LOGOUT -->
        <div class="sidebar-logout">
            <a href="/auth/logout">
                🚪 Toka kwenye Mfumo
            </a>
        </div>
    </aside>

    <!-- ===== MAIN ===== -->
    <main class="admin-main">
