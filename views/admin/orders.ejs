<!-- ================== FIRESTORE: ORDERS LOGIC ================== -->
<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import {
        getFirestore,
        collection,
        getDocs,
        doc,
        updateDoc,
        deleteDoc,
        serverTimestamp
    } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

    // Your web app's Firebase configuration
    const firebaseConfig = {
        apiKey: "AIzaSyC-8IRm50zrlHWjG-jpfzrh0YtprC1Tsaw",
        authDomain: "product-store-6a651.firebaseapp.com",
        projectId: "product-store-6a651",
        storageBucket: "product-store-6a651.firebasestorage.app",
        messagingSenderId: "379449735108",
        appId: "1:379449735108:web:bf0bb51d68f28273cdd691"
    };

    // Initialize Firebase
    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);

    // ===== STATE =====
    let allOrders = [];
    let currentFilter = 'all';
    let currentSearch = '';
    let currentOrderId = null;

    // ===== HELPERS =====
    const STATUS_SW = {
        pending: 'Inasubiri',
        confirmed: 'Imethibitishwa',
        shipped: 'Imesafirishwa',
        delivered: 'Imefikishwa',
        cancelled: 'Imefutwa'
    };

    function formatPrice(v) {
        return 'TZS ' + (Number(v) || 0).toLocaleString('en-US');
    }

    function formatDate(val) {
        if (!val) return '—';
        let seconds = 0;
        if (typeof val === 'object' && val.seconds) seconds = val.seconds;
        else if (val instanceof Date) seconds = val.getTime() / 1000;
        else return '—';
        const d = new Date(seconds * 1000);
        return d.toLocaleDateString('sw-TZ', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    function formatDateTime(val) {
        if (!val) return '—';
        let seconds = 0;
        if (typeof val === 'object' && val.seconds) seconds = val.seconds;
        else if (val instanceof Date) seconds = val.getTime() / 1000;
        else return '—';
        const d = new Date(seconds * 1000);
        return d.toLocaleString('sw-TZ', {
            day: '2-digit', month: 'short', year: 'numeric',
            hour: '2-digit', minute: '2-digit'
        });
    }

    function escapeHtml(s) {
        return String(s || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function showToast(msg, type = 'success') {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.className = 'toast show ' + type;
        setTimeout(() => { t.className = 'toast ' + type; }, 3000);
    }

    function statusBadge(status) {
        const cls = 'status-' + (status || 'pending');
        const label = STATUS_SW[status] || 'Inasubiri';
        return `<span class="status-badge ${cls}">${label}</span>`;
    }

    // ===== SIDEBAR TOGGLE =====
    window.toggleSidebar = function () {
        document.getElementById('adminSidebar').classList.toggle('open');
        document.getElementById('sidebarOverlay').classList.toggle('show');
    };

    // ===== RENDER =====
    function renderOrders() {
        const body = document.getElementById('ordersBody');

        let list = allOrders.filter(({ data: o }) => {
            // Filter by status
            if (currentFilter !== 'all') {
                const s = o.status || 'pending';
                if (s !== currentFilter) return false;
            }
            // Search
            if (currentSearch) {
                const q = currentSearch.toLowerCase();
                const name = (o.customerName || '').toLowerCase();
                const phone = (o.customerPhone || '').toLowerCase();
                const oid = (o.orderId || '').toLowerCase();
                if (!name.includes(q) && !phone.includes(q) && !oid.includes(q)) return false;
            }
            return true;
        });

        if (list.length === 0) {
            body.innerHTML = `
                <div class="table-empty">
                    <span class="icon">📭</span>
                    <h3>Hakuna oda zilizopatikana</h3>
                    <p>${currentSearch || currentFilter !== 'all' ? 'Jaribu kubadilisha chujio au utafutaji.' : 'Oda mpya zitaonekana hapa.'}</p>
                </div>
            `;
            return;
        }

        let rows = '';
        list.forEach(({ id, data: o }) => {
            const itemsCount = (o.items || []).reduce((s, i) => s + (Number(i.quantity) || 0), 0);
            rows += `
                <tr>
                    <td>
                        <div class="order-id">${escapeHtml(o.orderId || id.slice(0, 8))}</div>
                        <div class="order-date">${formatDate(o.createdAt)}</div>
                    </td>
                    <td>
                        <div class="customer-cell">
                            <strong>${escapeHtml(o.customerName || '—')}</strong>
                            <span>${escapeHtml(o.customerPhone || '')}</span>
                        </div>
                    </td>
                    <td class="hide-mobile">
                        <span class="order-items-count">${itemsCount} bidhaa</span>
                    </td>
                    <td>
                        <span class="order-total">${formatPrice(o.total)}</span>
                    </td>
                    <td class="hide-mobile">
                        ${statusBadge(o.status)}
                    </td>
                    <td>
                        <div class="row-actions">
                            <button class="row-btn view" onclick="openOrderModal('${id}')" title="Ona">👁️</button>
                        </div>
                    </td>
                </tr>
            `;
        });

        body.innerHTML = `
            <table class="orders-table">
                <thead>
                    <tr>
                        <th>Oda</th>
                        <th>Mteja</th>
                        <th class="hide-mobile">Bidhaa</th>
                        <th>Jumla</th>
                        <th class="hide-mobile">Hali</th>
                        <th>Vitendo</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
            </table>
        `;
    }

    // ===== MINI STATS =====
    function renderMiniStats() {
        const counts = { all: allOrders.length, pending: 0, confirmed: 0, shipped: 0, delivered: 0, cancelled: 0 };
        allOrders.forEach(({ data: o }) => {
            const s = o.status || 'pending';
            if (counts[s] !== undefined) counts[s] += 1;
        });

        document.getElementById('msAll').textContent = counts.all;
        document.getElementById('msPending').textContent = counts.pending;
        document.getElementById('msConfirmed').textContent = counts.confirmed;
        document.getElementById('msShipped').textContent = counts.shipped;
        document.getElementById('msDelivered').textContent = counts.delivered;
    }

    // ===== LOAD =====
    async function loadOrders() {
        const body = document.getElementById('ordersBody');
        try {
            const snap = await getDocs(collection(db, 'orders'));
            allOrders = snap.docs.map(d => ({ id: d.id, data: d.data() }));

            // Sort by newest
            allOrders.sort((a, b) => {
                const ta = a.data.createdAt?.seconds || 0;
                const tb = b.data.createdAt?.seconds || 0;
                return tb - ta;
            });

            renderMiniStats();
            renderOrders();

        } catch (err) {
            console.error('Kosa la kupakia oda:', err);
            body.innerHTML = `
                <div class="table-empty">
                    <span class="icon">⚠️</span>
                    <h3>Imeshindikana kupakia oda</h3>
                    <p>${escapeHtml(err.message)}</p>
                </div>
            `;
        }
    }

    // ===== SEARCH =====
    document.getElementById('searchInput').addEventListener('input', (e) => {
        currentSearch = e.target.value.trim();
        renderOrders();
    });

    // ===== FILTER CHIPS =====
    document.querySelectorAll('.filter-chip').forEach(chip => {
        chip.addEventListener('click', () => {
            document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
            document.querySelectorAll('.mini-stat').forEach(c => c.classList.remove('active'));
            chip.classList.add('active');
            currentFilter = chip.dataset.filter;
            renderOrders();
        });
    });

    // ===== MINI STATS CLICK =====
    document.querySelectorAll('.mini-stat').forEach(stat => {
        stat.addEventListener('click', () => {
            document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
            document.querySelectorAll('.mini-stat').forEach(c => c.classList.remove('active'));
            stat.classList.add('active');
            currentFilter = stat.dataset.filter;
            // Sync filter chip
            const chip = document.querySelector(`.filter-chip[data-filter="${currentFilter}"]`);
            if (chip) chip.classList.add('active');
            renderOrders();
        });
    });

    // ===== OPEN ORDER MODAL =====
    window.openOrderModal = function (id) {
        const item = allOrders.find(o => o.id === id);
        if (!item) return;
        currentOrderId = id;
        const o = item.data;

        document.getElementById('modalOrderId').textContent = o.orderId || id;

        const items = o.items || [];
        let itemsHtml = '';
        if (items.length === 0) {
            itemsHtml = `<p style="color:var(--gray);font-size:13px;">Hakuna bidhaa kwenye oda hii.</p>`;
        } else {
            itemsHtml = '<div class="item-list">';
            items.forEach(it => {
                const imgHtml = it.image
                    ? `<img src="${escapeHtml(it.image)}" alt="${escapeHtml(it.name)}">`
                    : `<div class="placeholder">👕</div>`;
                const meta = [];
                if (it.size) meta.push(`Ukubwa: ${escapeHtml(it.size)}`);
                if (it.color) meta.push(`Rangi: ${escapeHtml(it.color)}`);
                const lineTotal = (Number(it.price) || 0) * (Number(it.quantity) || 0);

                itemsHtml += `
                    <div class="order-item-row">
                        <div class="thumb">${imgHtml}</div>
                        <div class="info">
                            <h4>${escapeHtml(it.name || 'Bidhaa')}</h4>
                            <p>${meta.join(' • ') || '—'}</p>
                        </div>
                        <div class="price-info">
                            <div class="qty">${it.quantity} × ${formatPrice(it.price)}</div>
                            <div class="pr">${formatPrice(lineTotal)}</div>
                        </div>
                    </div>
                `;
            });
            itemsHtml += '</div>';
        }

        const currentStatus = o.status || 'pending';
        const statusButtons = ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled']
            .map(s => `
                <button class="status-btn ${s} ${currentStatus === s ? 'active' : ''}"
                        onclick="changeStatus('${s}')">
                    ${STATUS_SW[s]}
                </button>
            `).join('');

        document.getElementById('modalBody').innerHTML = `
            <!-- CUSTOMER -->
            <div class="detail-section">
                <h3>👤 Taarifa za Mteja</h3>
                <div class="detail-grid">
                    <div class="detail-item">
                        <label>Jina</label>
                        <p>${escapeHtml(o.customerName || '—')}</p>
                    </div>
                    <div class="detail-item">
                        <label>Simu</label>
                        <p>${escapeHtml(o.customerPhone || '—')}</p>
                    </div>
                    <div class="detail-item">
                        <label>Barua Pepe</label>
                        <p>${escapeHtml(o.customerEmail || '—')}</p>
                    </div>
                    <div class="detail-item">
                        <label>Mkoa / Wilaya</label>
                        <p>${escapeHtml(o.region || '—')} / ${escapeHtml(o.district || '—')}</p>
                    </div>
                    <div class="detail-item" style="grid-column:1/-1;">
                        <label>Anwani</label>
                        <p>${escapeHtml(o.address || '—')}</p>
                    </div>
                    ${o.notes ? `
                        <div class="detail-item" style="grid-column:1/-1;">
                            <label>Maelezo ya Ziada</label>
                            <p>${escapeHtml(o.notes)}</p>
                        </div>
                    ` : ''}
                </div>
            </div>

            <!-- ORDER INFO -->
            <div class="detail-section">
                <h3>📋 Taarifa za Oda</h3>
                <div class="detail-grid">
                    <div class="detail-item">
                        <label>Tarehe</label>
                        <p>${formatDateTime(o.createdAt)}</p>
                    </div>
                    <div class="detail-item">
                        <label>Njia ya Malipo</label>
                        <p>${o.paymentMethod === 'cod' ? 'Cash on Delivery' : escapeHtml(o.paymentMethod || '—')}</p>
                    </div>
                    <div class="detail-item">
                        <label>Hali ya Sasa</label>
                        <p>${statusBadge(currentStatus)}</p>
                    </div>
                    <div class="detail-item">
                        <label>Jumla ya Bidhaa</label>
                        <p>${o.totalQty || 0} bidhaa</p>
                    </div>
                </div>
            </div>

            <!-- ITEMS -->
            <div class="detail-section">
                <h3>🛍️ Bidhaa Zilizoagizwa</h3>
                ${itemsHtml}

                <div class="totals-box">
                    <div class="totals-row">
                        <span>Jumla ndogo</span>
                        <span>${formatPrice(o.subtotal)}</span>
                    </div>
                    <div class="totals-row">
                        <span>Usafirishaji</span>
                        <span>${o.shippingFee > 0 ? formatPrice(o.shippingFee) : 'BURE'}</span>
                    </div>
                    <div class="totals-row">
                        <span>JUMLA KUU</span>
                        <span>${formatPrice(o.total)}</span>
                    </div>
                </div>
            </div>

            <!-- STATUS UPDATE -->
            <div class="detail-section">
                <h3>🔄 Badilisha Hali ya Oda</h3>
                <div class="status-actions">
                    ${statusButtons}
                </div>
            </div>
        `;

        document.getElementById('orderModal').classList.add('show');
    };

    window.closeModal = function () {
        document.getElementById('orderModal').classList.remove('show');
        currentOrderId = null;
    };

    // ===== CHANGE STATUS =====
    window.changeStatus = async function (newStatus) {
        if (!currentOrderId) return;

        try {
            await updateDoc(doc(db, 'orders', currentOrderId), {
                status: newStatus,
                updatedAt: serverTimestamp()
            });

            // Update local data
            const item = allOrders.find(o => o.id === currentOrderId);
            if (item) item.data.status = newStatus;

            showToast(`✅ Hali imebadilishwa: ${STATUS_SW[newStatus]}`, 'success');

            renderMiniStats();
            renderOrders();

            // Re-render modal
            openOrderModal(currentOrderId);

        } catch (err) {
            console.error('Kosa la kubadilisha hali:', err);
            showToast('❌ Imeshindikana kubadilisha hali: ' + err.message, 'error');
        }
    };

    // ===== CANCEL/DELETE ORDER =====
    window.cancelOrder = async function () {
        if (!currentOrderId) return;
        if (!confirm('Una uhakika unataka kufuta oda hii kabisa? Kitendo hiki hakiwezi kurudishwa.')) return;

        try {
            await deleteDoc(doc(db, 'orders', currentOrderId));
            showToast('🗑️ Oda imefutwa', 'success');
            closeModal();
            await loadOrders();
        } catch (err) {
            console.error('Kosa la kufuta oda:', err);
            showToast('❌ Imeshindikana kufuta oda: ' + err.message, 'error');
        }
    };

    // ===== INIT =====
    loadOrders();
</script>

<%- include('../partials/footer') %>
