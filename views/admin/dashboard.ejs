<%- include('../partials/header', { title: 'Dashibodi' }) %>
<%- include('../partials/admin-sidebar', { adminPage: 'dashboard' }) %>

<!-- ================== DASHBOARD STYLES ================== -->
<style>
    /* ===== STATS GRID ===== */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 26px;
    }

    .stat-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 22px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        transition: all 0.25s ease;
        position: relative;
        overflow: hidden;
    }

    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
    }

    .stat-card::after {
        content: "";
        position: absolute;
        right: -30px;
        top: -30px;
        width: 100px;
        height: 100px;
        border-radius: 50%;
        opacity: 0.08;
    }

    .stat-card.orange::after { background: var(--accent); }
    .stat-card.green::after { background: var(--success); }
    .stat-card.blue::after { background: #3b82f6; }
    .stat-card.red::after { background: var(--danger); }

    .stat-info h4 {
        font-size: 13px;
        font-weight: 600;
        color: var(--gray);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 10px;
    }

    .stat-info h2 {
        font-size: 26px;
        font-weight: 800;
        color: var(--primary);
        letter-spacing: -0.6px;
        line-height: 1.1;
        margin-bottom: 6px;
    }

    .stat-info .change {
        font-size: 12.5px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .stat-info .change.up { color: var(--success); }
    .stat-info .change.down { color: var(--danger); }
    .stat-info .change.neutral { color: var(--gray); }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
        position: relative;
        z-index: 2;
    }

    .stat-icon.orange { background: rgba(255, 107, 0, 0.12); }
    .stat-icon.green { background: rgba(16, 185, 129, 0.12); }
    .stat-icon.blue { background: rgba(59, 130, 246, 0.12); }
    .stat-icon.red { background: rgba(239, 68, 68, 0.12); }

    /* ===== GRID 2-COL ===== */
    .grid-2 {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-bottom: 26px;
    }

    /* ===== PANEL ===== */
    .panel {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
    }

    .panel-head {
        padding: 18px 22px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }

    .panel-head h3 {
        font-size: 16px;
        font-weight: 700;
        color: var(--primary);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .panel-head h3 span { color: var(--accent); }

    .panel-head a {
        font-size: 13px;
        font-weight: 600;
        color: var(--accent);
    }

    .panel-head a:hover { text-decoration: underline; }

    .panel-body {
        padding: 18px 22px;
    }

    /* ===== RECENT ORDERS TABLE ===== */
    .orders-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
    }

    .orders-table th {
        text-align: left;
        font-size: 11.5px;
        font-weight: 700;
        color: var(--gray);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 12px 10px;
        border-bottom: 1px solid var(--border);
    }

    .orders-table td {
        padding: 14px 10px;
        border-bottom: 1px solid var(--border);
        color: var(--primary);
        vertical-align: middle;
    }

    .orders-table tr:last-child td { border-bottom: none; }

    .orders-table tr:hover td {
        background: var(--light);
    }

    .order-id {
        font-weight: 700;
        color: var(--primary);
        font-size: 12.5px;
        letter-spacing: 0.3px;
    }

    .customer-cell {
        display: flex;
        flex-direction: column;
    }

    .customer-cell strong {
        font-weight: 600;
        color: var(--primary);
        font-size: 13.5px;
    }

    .customer-cell span {
        font-size: 12px;
        color: var(--gray);
    }

    .order-total {
        font-weight: 700;
        color: var(--primary);
    }

    /* ===== STATUS BADGES ===== */
    .status-badge {
        display: inline-block;
        font-size: 11.5px;
        font-weight: 700;
        padding: 4px 11px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .status-pending { background: #fef3c7; color: #92400e; }
    .status-confirmed { background: #dbeafe; color: #1e40af; }
    .status-shipped { background: #e0e7ff; color: #4338ca; }
    .status-delivered { background: #d1fae5; color: #065f46; }
    .status-cancelled { background: #fee2e2; color: #991b1b; }

    /* ===== QUICK ACTIONS ===== */
    .quick-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .quick-action {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 16px;
        background: var(--light);
        border-radius: 10px;
        transition: all 0.2s ease;
        border: 1px solid transparent;
    }

    .quick-action:hover {
        background: var(--white);
        border-color: var(--accent);
        transform: translateX(4px);
    }

    .quick-action .qa-icon {
        width: 38px;
        height: 38px;
        background: var(--white);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .quick-action:hover .qa-icon {
        background: var(--accent);
    }

    .quick-action .qa-info {
        flex: 1;
    }

    .quick-action .qa-info h4 {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 2px;
    }

    .quick-action .qa-info p {
        font-size: 12px;
        color: var(--gray);
    }

    .quick-action .qa-arrow {
        color: var(--gray);
        font-size: 16px;
        transition: color 0.2s ease;
    }

    .quick-action:hover .qa-arrow {
        color: var(--accent);
    }

    /* ===== MESSAGES LIST ===== */
    .messages-list {
        display: flex;
        flex-direction: column;
    }

    .message-item {
        display: flex;
        gap: 12px;
        padding: 14px 0;
        border-bottom: 1px solid var(--border);
    }

    .message-item:last-child { border-bottom: none; }

    .msg-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent), #ff8c33);
        color: var(--white);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .msg-info {
        flex: 1;
        min-width: 0;
    }

    .msg-info h4 {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .msg-info p {
        font-size: 12.5px;
        color: var(--gray);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 3px;
    }

    .msg-info .time {
        font-size: 11px;
        color: #9ca3af;
    }

    /* ===== LOADING / EMPTY ===== */
    .dash-loading,
    .dash-empty {
        text-align: center;
        padding: 40px 20px;
        color: var(--gray);
    }

    .dash-loading .spinner { margin: 0 auto 14px; }

    .dash-empty {
        font-size: 13.5px;
    }

    .dash-empty .icon {
        font-size: 40px;
        display: block;
        margin-bottom: 8px;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 1100px) {
        .stats-grid { grid-template-columns: repeat(2, 1fr); }
        .grid-2 { grid-template-columns: 1fr; }
    }

    @media (max-width: 600px) {
        .stats-grid { grid-template-columns: 1fr; }
        .orders-table { font-size: 12.5px; }
        .orders-table th,
        .orders-table td { padding: 10px 6px; }
        .orders-table .hide-mobile { display: none; }
    }
</style>

