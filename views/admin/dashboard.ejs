<!-- ================== FIRESTORE: DASHBOARD LOGIC ================== -->
<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import {
        getFirestore,
        collection,
        getDocs,
        query,
        orderBy,
        limit
    } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

    // Your web app's Firebase configuration
    const firebaseConfig = {
        apiKey: "AIzaSyC-8IRm50zrlHWjG-jpfzrh0YtprC1Tsaw",
        authDomain: "product-store-6a651.firebaseapp.com",
        projectId: "product-store-6a651",
        storageBucket: "product-store-6a651.firebasestorage.app",
        messagingSenderId: "379449735108",
        appId: "1:379449735108:web:bf0bb51d68f28273cdd691"
    };

    // Initialize Firebase
    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);

    // ===== HELPERS =====
    function formatPrice(v) {
        return 'TZS ' + (Number(v) || 0).toLocaleString('en-US');
    }

    function shortPrice(v) {
        const n = Number(v) || 0;
        if (n >= 1000000) return 'TZS ' + (n / 1000000).toFixed(1) + 'M';
        if (n >= 1000) return 'TZS ' + (n / 1000).toFixed(1) + 'K';
        return 'TZS ' + n;
    }

    function timeAgo(val) {
        if (!val) return '—';
        let seconds = 0;
        if (typeof val === 'object' && val.seconds) seconds = val.seconds;
        else if (val instanceof Date) seconds = val.getTime() / 1000;
        else return '—';

        const diff = Math.floor(Date.now() / 1000) - seconds;
        if (diff < 60) return 'Sasa hivi';
        if (diff < 3600) return Math.floor(diff / 60) + 'd';
        if (diff < 86400) return Math.floor(diff / 3600) + 'h';
        if (diff < 604800) return Math.floor(diff / 86400) + 'siku';
        const d = new Date(seconds * 1000);
        return d.toLocaleDateString('sw-TZ', { day: '2-digit', month: 'short' });
    }

    function formatDate(val) {
        if (!val) return '—';
        let seconds = 0;
        if (typeof val === 'object' && val.seconds) seconds = val.seconds;
        else if (val instanceof Date) seconds = val.getTime() / 1000;
        else return '—';
        const d = new Date(seconds * 1000);
        return d.toLocaleDateString('sw-TZ', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    function capitalize(s) {
        if (!s) return '';
        return s.charAt(0).toUpperCase() + s.slice(1);
    }

    // ===== STATUS MAP =====
    const STATUS_SW = {
        pending: 'Inasubiri',
        confirmed: 'Imethibitishwa',
        shipped: 'Imesafirishwa',
        delivered: 'Imefikishwa',
        cancelled: 'Imefutwa'
    };

    function statusBadge(status) {
        const cls = 'status-' + (status || 'pending');
        const label = STATUS_SW[status] || 'Inasubiri';
        return `<span class="status-badge ${cls}">${label}</span>`;
    }

    // ===== STATS =====
    async function loadStats() {
        try {
            const [ordersSnap, productsSnap] = await Promise.all([
                getDocs(collection(db, 'orders')),
                getDocs(collection(db, 'products'))
            ]);

            const orders = ordersSnap.docs.map(d => d.data());
            const products = productsSnap.docs.map(d => d.data());

            const totalOrders = orders.length;
            const totalRevenue = orders
                .filter(o => o.status !== 'cancelled')
                .reduce((sum, o) => sum + (Number(o.total) || 0), 0);
            const totalProducts = products.length;
            const pendingOrders = orders.filter(o => o.status === 'pending').length;

            document.getElementById('statOrders').textContent = totalOrders.toLocaleString();
            document.getElementById('statRevenue').textContent = shortPrice(totalRevenue);
            document.getElementById('statRevenue').title = formatPrice(totalRevenue);
            document.getElementById('statProducts').textContent = totalProducts.toLocaleString();
            document.getElementById('statPending').textContent = pendingOrders.toLocaleString();

            // Simple change indicators (kutoka oda zote)
            document.getElementById('statOrdersChange').textContent = `📊 Oda ${totalOrders} zote`;
            document.getElementById('statRevenueChange').textContent = `💰 Mapato ya jumla`;
            document.getElementById('statProductsChange').textContent = `👕 Bidhaa ${totalProducts} dukani`;

            if (pendingOrders > 0) {
                document.getElementById('statPendingChange').textContent = `⚠️ Zinahitaji uangalizi`;
            } else {
                document.getElementById('statPendingChange').textContent = `✓ Hakuna oda mpya`;
            }

        } catch (err) {
            console.error('Kosa la kupakia stats:', err);
            document.getElementById('statOrders').textContent = '!';
            document.getElementById('statRevenue').textContent = '!';
            document.getElementById('statProducts').textContent = '!';
            document.getElementById('statPending').textContent = '!';
        }
    }

    // ===== RECENT ORDERS =====
    async function loadRecentOrders() {
        const body = document.getElementById('recentOrdersBody');

        try {
            let snap;
            try {
                const q = query(collection(db, 'orders'), orderBy('createdAt', 'desc'), limit(6));
                snap = await getDocs(q);
            } catch (e) {
                // Kama index haipo, chukua zote
                snap = await getDocs(collection(db, 'orders'));
            }

            if (snap.empty) {
                body.innerHTML = `
                    <div class="dash-empty">
                        <span class="icon">📭</span>
                        <p>Hakuna oda bado. Oda zitaonekana hapa.</p>
                    </div>
                `;
                return;
            }

            let orders = snap.docs.map(d => ({ id: d.id, data: d.data() }));

            // Sort manually kama orderBy haipo
            orders.sort((a, b) => {
                const ta = a.data.createdAt?.seconds || 0;
                const tb = b.data.createdAt?.seconds || 0;
                return tb - ta;
            });
            orders = orders.slice(0, 6);

            let rows = '';
            orders.forEach(({ id, data: o }) => {
                const itemsCount = (o.items || []).reduce((s, i) => s + (Number(i.quantity) || 0), 0);
                rows += `
                    <tr>
                        <td>
                            <div class="order-id">${o.orderId || id.slice(0, 8)}</div>
                        </td>
                        <td>
                            <div class="customer-cell">
                                <strong>${o.customerName || '—'}</strong>
                                <span>${o.customerPhone || ''}</span>
                            </div>
                        </td>
                        <td class="hide-mobile">
                            <span style="color:var(--gray);font-size:12.5px;">
                                ${itemsCount} bidhaa
                            </span>
                        </td>
                        <td class="order-total">${formatPrice(o.total)}</td>
                        <td class="hide-mobile">${statusBadge(o.status)}</td>
                    </tr>
                `;
            });

            body.innerHTML = `
                <table class="orders-table">
                    <thead>
                        <tr>
                            <th>Oda</th>
                            <th>Mteja</th>
                            <th class="hide-mobile">Bidhaa</th>
                            <th>Jumla</th>
                            <th class="hide-mobile">Hali</th>
                        </tr>
                    </thead>
                    <tbody>${rows}</tbody>
                </table>
            `;

        } catch (err) {
            console.error('Kosa la oda:', err);
            body.innerHTML = `
                <div class="dash-empty">
                    <span class="icon">⚠️</span>
                    <p>Imeshindikana kupakia oda: ${err.message}</p>
                </div>
            `;
        }
    }

    // ===== MESSAGES =====
    async function loadMessages() {
        const body = document.getElementById('messagesBody');

        try {
            let snap;
            try {
                const q = query(collection(db, 'messages'), orderBy('createdAt', 'desc'), limit(5));
                snap = await getDocs(q);
            } catch (e) {
                snap = await getDocs(collection(db, 'messages'));
            }

            if (snap.empty) {
                body.innerHTML = `
                    <div class="dash-empty">
                        <span class="icon">📭</span>
                        <p>Hakuna ujumbe bado kutoka kwa wateja.</p>
                    </div>
                `;
                return;
            }

            let messages = snap.docs.map(d => d.data());
            messages.sort((a, b) => {
                const ta = a.createdAt?.seconds || 0;
                const tb = b.createdAt?.seconds || 0;
                return tb - ta;
            });
            messages = messages.slice(0, 5);

            let html = '<div class="messages-list">';
            messages.forEach(m => {
                const initial = (m.name || 'M').charAt(0).toUpperCase();
                html += `
                    <div class="message-item">
                        <div class="msg-avatar">${initial}</div>
                        <div class="msg-info">
                            <h4>${m.name || 'Mtumiaji'}</h4>
                            <p>${m.subject ? '📌 ' + m.subject + ' — ' : ''}${m.message || ''}</p>
                            <div class="time">${timeAgo(m.createdAt)} • ${m.email || ''}</div>
                        </div>
                    </div>
                `;
            });
            html += '</div>';

            body.innerHTML = html;

        } catch (err) {
            console.error('Kosa la ujumbe:', err);
            body.innerHTML = `
                <div class="dash-empty">
                    <span class="icon">⚠️</span>
                    <p>Imeshindikana kupakia ujumbe: ${err.message}</p>
                </div>
            `;
        }
    }

    // ===== INIT =====
    loadStats();
    loadRecentOrders();
    loadMessages();

    // ===== SIDEBAR TOGGLE =====
    window.toggleSidebar = function () {
        document.getElementById('adminSidebar').classList.toggle('open');
        document.getElementById('sidebarOverlay').classList.toggle('show');
    };
</script>

