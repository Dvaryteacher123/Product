<%- include('../partials/header', { title: 'Bidhaa - Admin' }) %>
<%- include('../partials/admin-sidebar', { adminPage: 'products' }) %>

<!-- ================== PRODUCTS STYLES ================== -->
<style>
    /* ===== TOP BAR ===== */
    .page-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .search-box {
        position: relative;
        min-width: 220px;
    }

    .search-box input {
        width: 100%;
        padding: 10px 14px 10px 38px;
        border: 1.5px solid var(--border);
        border-radius: 8px;
        font-size: 14px;
        background: var(--white);
    }

    .search-box input:focus { border-color: var(--accent); }

    .search-box .icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 14px;
        color: var(--gray);
    }

    .btn-add {
        background: var(--accent);
        color: var(--white);
        padding: 11px 22px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: background 0.2s ease;
    }

    .btn-add:hover { background: var(--accent-hover); }

    /* ===== FILTER BAR ===== */
    .filter-bar {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 20px;
        padding: 14px 18px;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 12px;
    }

    .filter-chip {
        padding: 7px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        background: var(--light);
        color: var(--gray);
        cursor: pointer;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        font-family: inherit;
    }

    .filter-chip:hover { color: var(--primary); border-color: var(--border); }

    .filter-chip.active {
        background: var(--primary);
        color: var(--white);
    }

    /* ===== PRODUCTS TABLE ===== */
    .products-panel {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
    }

    .products-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
    }

    .products-table th {
        text-align: left;
        font-size: 11.5px;
        font-weight: 700;
        color: var(--gray);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 14px 16px;
        background: var(--light);
        border-bottom: 1px solid var(--border);
    }

    .products-table td {
        padding: 14px 16px;
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
    }

    .products-table tr:last-child td { border-bottom: none; }

    .products-table tr:hover td { background: #fafafa; }

    /* ===== PRODUCT CELL ===== */
    .product-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .product-thumb {
        width: 52px;
        height: 52px;
        border-radius: 8px;
        background: var(--light);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex-shrink: 0;
        border: 1px solid var(--border);
    }

    .product-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .product-thumb .placeholder {
        font-size: 24px;
        color: #9ca3af;
    }

    .product-details h4 {
        font-size: 14px;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 3px;
        line-height: 1.3;
        max-width: 260px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .product-details p {
        font-size: 12px;
        color: var(--gray);
    }

    /* ===== PRICE ===== */
    .price-cell {
        font-weight: 700;
        color: var(--primary);
        font-size: 14px;
    }

    .price-cell .old {
        font-size: 11.5px;
        color: var(--gray);
        text-decoration: line-through;
        font-weight: 500;
        display: block;
    }

    /* ===== STOCK BADGE ===== */
    .stock-badge {
        display: inline-block;
        font-size: 11.5px;
        font-weight: 700;
        padding: 4px 11px;
        border-radius: 20px;
    }

    .stock-in { background: #d1fae5; color: #065f46; }
    .stock-low { background: #fef3c7; color: #92400e; }
    .stock-out { background: #fee2e2; color: #991b1b; }

    /* ===== CATEGORY TAG ===== */
    .cat-tag {
        display: inline-block;
        font-size: 11.5px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 6px;
        background: var(--light);
        color: var(--gray);
        text-transform: capitalize;
    }

    /* ===== ROW ACTIONS ===== */
    .row-actions {
        display: flex;
        gap: 6px;
    }

    .row-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        background: var(--light);
        transition: all 0.2s ease;
        border: 1px solid transparent;
    }

    .row-btn:hover {
        border-color: var(--border);
        background: var(--white);
    }

    .row-btn.edit:hover { background: #dbeafe; }
    .row-btn.delete:hover { background: #fee2e2; }

    /* ===== LOADING / EMPTY ===== */
    .table-empty {
        text-align: center;
        padding: 60px 20px;
        color: var(--gray);
    }

    .table-empty .icon {
        font-size: 60px;
        display: block;
        margin-bottom: 12px;
    }

    .table-empty h3 {
        font-size: 17px;
        color: var(--primary);
        margin-bottom: 6px;
    }

    /* ===== MODAL ===== */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.55);
        z-index: 1500;
        align-items: flex-start;
        justify-content: center;
        padding: 30px 16px;
        overflow-y: auto;
    }

    .modal-overlay.show {
        display: flex;
    }

    .modal {
        background: var(--white);
        border-radius: 14px;
        width: 100%;
        max-width: 640px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);
        animation: modalIn 0.25s ease;
        margin-top: 20px;
    }

    @keyframes modalIn {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .modal-head {
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .modal-head h2 {
        font-size: 18px;
        font-weight: 800;
        color: var(--primary);
        letter-spacing: -0.3px;
    }

    .modal-close {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: var(--light);
        font-size: 18px;
        color: var(--gray);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .modal-close:hover {
        background: var(--danger);
        color: var(--white);
    }

    .modal-body {
        padding: 24px;
        max-height: 65vh;
        overflow-y: auto;
    }

    .modal-body::-webkit-scrollbar { width: 6px; }
    .modal-body::-webkit-scrollbar-thumb {
        background: var(--border);
        border-radius: 4px;
    }

    /* ===== FORM ===== */
    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group.full { grid-column: 1 / -1; }

    .form-group label {
        font-size: 13px;
        font-weight: 600;
        color: var(--primary);
        margin-bottom: 7px;
    }

    .form-group label .req { color: var(--danger); }

    .form-group input,
    .form-group textarea,
    .form-group select {
        padding: 11px 14px;
        border: 1.5px solid var(--border);
        border-radius: 8px;
        font-size: 14px;
        color: var(--primary);
        background: var(--white);
        transition: border-color 0.2s ease;
        font-family: inherit;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
        border-color: var(--accent);
        outline: none;
    }

    .form-group textarea {
        resize: vertical;
        min-height: 90px;
    }

    .form-group .error-msg {
        font-size: 12px;
        color: var(--danger);
        margin-top: 4px;
        display: none;
    }

    .form-group.error input,
    .form-group.error textarea,
    .form-group.error select {
        border-color: var(--danger);
    }

    .form-group.error .error-msg { display: block; }

    .form-hint {
        font-size: 11.5px;
        color: var(--gray);
        margin-top: 5px;
    }

    .modal-foot {
        padding: 18px 24px;
        border-top: 1px solid var(--border);
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        background: var(--light);
    }

    .btn-cancel {
        padding: 11px 20px;
        background: var(--white);
        border: 1.5px solid var(--border);
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        color: var(--primary);
    }

    .btn-cancel:hover { border-color: var(--primary); }

    .btn-save {
        padding: 11px 26px;
        background: var(--accent);
        color: var(--white);
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        transition: background 0.2s ease;
    }

    .btn-save:hover:not(:disabled) { background: var(--accent-hover); }

    .btn-save:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    /* ===== DELETE MODAL ===== */
    .delete-modal {
        max-width: 420px;
        text-align: center;
        padding: 32px 26px;
    }

    .delete-modal .icon {
        width: 70px;
        height: 70px;
        background: #fee2e2;
        color: var(--danger);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        margin: 0 auto 16px;
    }

    .delete-modal h3 {
        font-size: 18px;
        color: var(--primary);
        margin-bottom: 8px;
    }

    .delete-modal p {
        font-size: 14px;
        color: var(--gray);
        margin-bottom: 24px;
        line-height: 1.6;
    }

    .delete-actions {
        display: flex;
        gap: 10px;
    }

    .delete-actions button {
        flex: 1;
        padding: 12px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
    }

    .btn-delete-confirm {
        background: var(--danger);
        color: var(--white);
    }

    .btn-delete-confirm:hover { background: #dc2626; }

    /* ===== TOAST ===== */
    .toast {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%) translateY(100px);
        background: var(--primary);
        color: var(--white);
        padding: 14px 24px;
        border-radius: 30px;
        font-size: 14px;
        font-weight: 600;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        z-index: 9999;
        opacity: 0;
        transition: all 0.35s ease;
    }

    .toast.show {
        transform: translateX(-50%) translateY(0);
        opacity: 1;
    }

    .toast.success { background: var(--success); }
    .toast.error { background: var(--danger); }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 900px) {
        .products-table .hide-mobile { display: none; }
        .form-grid { grid-template-columns: 1fr; }
        .search-box { min-width: 100%; }
        .page-actions { width: 100%; }
    }
</style>

<!-- ================== ADMIN HEADER ================== -->
<div class="admin-header">
    <div>
        <h1>👕 Bidhaa</h1>
        <p>Simamia bidhaa zote za duka lako</p>
    </div>
    <div class="page-actions">
        <div class="search-box">
            <span class="icon">🔍</span>
            <input type="text" id="searchInput" placeholder="Tafuta bidhaa...">
        </div>
        <button class="btn-add" onclick="openAddModal()">
            <span>➕</span> Ongeza Bidhaa
        </button>
    </div>
</div>

<!-- ================== FILTER BAR ================== -->
<div class="filter-bar" id="filterBar">
    <button class="filter-chip active" data-filter="all">Zote</button>
    <button class="filter-chip" data-filter="in">Zilizopo</button>
    <button class="filter-chip" data-filter="low">Zinakaribia Kuisha</button>
    <button class="filter-chip" data-filter="out">Zimeisha</button>
    <button class="filter-chip" data-filter="sale">Zinauzwa Punguzo</button>
</div>

<!-- ================== PRODUCTS PANEL ================== -->
<div class="products-panel">
    <div id="productsBody">
        <div class="table-empty">
            <div class="spinner" style="margin:0 auto 14px;"></div>
            <p>Inapakia bidhaa...</p>
        </div>
    </div>
</div>

</div><!-- /.admin-main -->
</div><!-- /.admin-layout -->

<!-- ================== ADD/EDIT MODAL ================== -->
<div class="modal-overlay" id="productModal">
    <div class="modal">
        <div class="modal-head">
            <h2 id="modalTitle">Ongeza Bidhaa</h2>
            <button class="modal-close" onclick="closeModal()">✕</button>
        </div>

        <div class="modal-body">
            <form id="productForm" novalidate>
                <input type="hidden" id="productId">

                <div class="form-grid">
                    <div class="form-group full" id="fNameGroup">
                        <label>Jina la Bidhaa <span class="req">*</span></label>
                        <input type="text" id="fName" placeholder="Mf. T-Shirt Nyeusi ya Kiume">
                        <span class="error-msg">Jina linahitajika</span>
                    </div>

                    <div class="form-group" id="fCategoryGroup">
                        <label>Aina <span class="req">*</span></label>
                        <select id="fCategory">
                            <option value="">-- Chagua --</option>
                            <option value="men">Wanaume</option>
                            <option value="women">Wanawake</option>
                            <option value="kids">Watoto</option>
                            <option value="shoes">Viatu</option>
                            <option value="accessories">Vifaa</option>
                        </select>
                        <span class="error-msg">Chagua aina</span>
                    </div>

                    <div class="form-group" id="fPriceGroup">
                        <label>Bei (TZS) <span class="req">*</span></label>
                        <input type="number" id="fPrice" placeholder="Mf. 25000" min="0">
                        <span class="error-msg">Bei inahitajika</span>
                    </div>

                    <div class="form-group">
                        <label>Bei ya Zamani (si lazima)</label>
                        <input type="number" id="fOldPrice" placeholder="Mf. 30000" min="0">
                        <div class="form-hint">Weka kama bidhaa ina punguzo</div>
                    </div>

                    <div class="form-group" id="fStockGroup">
                        <label>Idadi Iliyopo <span class="req">*</span></label>
                        <input type="number" id="fStock" placeholder="Mf. 50" min="0">
                        <span class="error-msg">Idadi inahitajika</span>
                    </div>

                    <div class="form-group full">
                        <label>Picha (URL)</label>
                        <input type="url" id="fImage" placeholder="https://...">
                        <div class="form-hint">Weka link ya picha ya bidhaa</div>
                    </div>

                    <div class="form-group full">
                        <label>Ukubwa (tenganisha kwa koma)</label>
                        <input type="text" id="fSizes" placeholder="Mf. S,M,L,XL">
                        <div class="form-hint">Acha wazi kama haina ukubwa</div>
                    </div>

                    <div class="form-group full">
                        <label>Rangi (tenganisha kwa koma)</label>
                        <input type="text" id="fColors" placeholder="Mf. Nyeusi,Nyeupe,Bluu">
                        <div class="form-hint">Acha wazi kama haina rangi</div>
                    </div>

                    <div class="form-group full">
                        <label>Maelezo</label>
                        <textarea id="fDescription" placeholder="Eleza bidhaa kwa ufupi..."></textarea>
                    </div>

                    <div class="form-group">
                        <label>Beji</label>
                        <select id="fBadge">
                            <option value="">Hakuna</option>
                            <option value="new">Mpya</option>
                            <option value="sale">Punguzo</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Kiwango (0-5)</label>
                        <input type="number" id="fRating" placeholder="Mf. 4.5" min="0" max="5" step="0.1">
                    </div>
                </div>
            </form>
        </div>

        <div class="modal-foot">
            <button class="btn-cancel" onclick="closeModal()">Ghairi</button>
            <button class="btn-save" id="saveBtn" onclick="saveProduct()">💾 Hifadhi</button>
        </div>
    </div>
</div>

<!-- ================== DELETE MODAL ================== -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal delete-modal">
        <div class="icon">🗑️</div>
        <h3>Futa Bidhaa?</h3>
        <p id="deleteMsg">Una uhakika unataka kufuta bidhaa hii? Kitendo hiki hakiwezi kurudishwa.</p>
        <div class="delete-actions">
            <button class="btn-cancel" onclick="closeDeleteModal()">Ghairi</button>
            <button class="btn-delete-confirm" id="confirmDeleteBtn" onclick="confirmDelete()">Ndiyo, Futa</button>
        </div>
    </div>
</div>

<!-- ================== TOAST ================== -->
<div class="toast" id="toast"></div>

<!-- ================== FIRESTORE: PRODUCTS LOGIC ================== -->
<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import {
        getFirestore,
        collection,
        getDocs,
        doc,
        addDoc,
        updateDoc,
        deleteDoc,
        serverTimestamp
    } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

    // Your web app's Firebase configuration
    const firebaseConfig = {
        apiKey: "AIzaSyC-8IRm50zrlHWjG-jpfzrh0YtprC1Tsaw",
        authDomain: "product-store-6a651.firebaseapp.com",
        projectId: "product-store-6a651",
        storageBucket: "product-store-6a651.firebasestorage.app",
        messagingSenderId: "379449735108",
        appId: "1:379449735108:web:bf0bb51d68f28273cdd691"
    };

    // Initialize Firebase
    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);

    // ===== STATE =====
    let allProducts = [];
    let currentFilter = 'all';
    let currentSearch = '';
    let deleteTargetId = null;

    // ===== HELPERS =====
    function formatPrice(v) {
        return 'TZS ' + (Number(v) || 0).toLocaleString('en-US');
    }

    function showToast(msg, type = 'success') {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.className = 'toast show ' + type;
        setTimeout(() => { t.className = 'toast ' + type; }, 3000);
    }

    function escapeHtml(s) {
        return String(s || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    // ===== SIDEBAR TOGGLE =====
    window.toggleSidebar = function () {
        document.getElementById('adminSidebar').classList.toggle('open');
        document.getElementById('sidebarOverlay').classList.toggle('show');
    };

    // ===== STOCK BADGE =====
    function stockBadge(stock) {
        const s = Number(stock) || 0;
        if (s <= 0) return `<span class="stock-badge stock-out">Imeisha</span>`;
        if (s <= 5) return `<span class="stock-badge stock-low">${s} zimebaki</span>`;
        return `<span class="stock-badge stock-in">${s} zipo</span>`;
    }

    // ===== RENDER =====
    function renderProducts() {
        const body = document.getElementById('productsBody');

        // Filter
        let list = allProducts.filter(({ data: p }) => {
            // Search
            if (currentSearch) {
                const q = currentSearch.toLowerCase();
                const name = (p.name || '').toLowerCase();
                const cat = (p.category || '').toLowerCase();
                if (!name.includes(q) && !cat.includes(q)) return false;
            }

            // Filter
            const stock = Number(p.stock) || 0;
            if (currentFilter === 'in' && stock <= 5) return false;
            if (currentFilter === 'low' && (stock <= 0 || stock > 5)) return false;
            if (currentFilter === 'out' && stock > 0) return false;
            if (currentFilter === 'sale') {
                const oldP = Number(p.oldPrice) || 0;
                if (oldP <= Number(p.price)) return false;
            }
            return true;
        });

        if (list.length === 0) {
            body.innerHTML = `
                <div class="table-empty">
                    <span class="icon">📦</span>
                    <h3>Hakuna bidhaa zilizopatikana</h3>
                    <p>${currentSearch || currentFilter !== 'all' ? 'Jaribu kubadilisha utafutaji au chujio.' : 'Ongeza bidhaa yako ya kwanza kwa kubonyeza "Ongeza Bidhaa".'}</p>
                </div>
            `;
            return;
        }

        let rows = '';
        list.forEach(({ id, data: p }) => {
            const imgHtml = p.image
                ? `<img src="${escapeHtml(p.image)}" alt="${escapeHtml(p.name)}">`
                : `<div class="placeholder">👕</div>`;

            const oldPriceHtml = (p.oldPrice && Number(p.oldPrice) > Number(p.price))
                ? `<span class="old">${formatPrice(p.oldPrice)}</span>`
                : '';

            rows += `
                <tr>
                    <td>
                        <div class="product-cell">
                            <div class="product-thumb">${imgHtml}</div>
                            <div class="product-details">
                                <h4>${escapeHtml(p.name || 'Bidhaa')}</h4>
                                <p>ID: ${id.slice(0, 8)}</p>
                            </div>
                        </div>
                    </td>
                    <td class="hide-mobile">
                        <span class="cat-tag">${escapeHtml(p.category || '—')}</span>
                    </td>
                    <td>
                        <div class="price-cell">
                            ${formatPrice(p.price)}
                            ${oldPriceHtml}
                        </div>
                    </td>
                    <td class="hide-mobile">
                        ${stockBadge(p.stock)}
                    </td>
                    <td>
                        <div class="row-actions">
                            <button class="row-btn edit" onclick="openEditModal('${id}')" title="Badilisha">✏️</button>
                            <button class="row-btn delete" onclick="openDeleteModal('${id}')" title="Futa">🗑️</button>
                        </div>
                    </td>
                </tr>
            `;
        });

        body.innerHTML = `
            <table class="products-table">
                <thead>
                    <tr>
                        <th>Bidhaa</th>
                        <th class="hide-mobile">Aina</th>
                        <th>Bei</th>
                        <th class="hide-mobile">Idadi</th>
                        <th>Vitendo</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
            </table>
        `;
    }

    // ===== LOAD PRODUCTS =====
    async function loadProducts() {
        const body = document.getElementById('productsBody');
        try {
            const snap = await getDocs(collection(db, 'products'));
            allProducts = snap.docs.map(d => ({ id: d.id, data: d.data() }));

            // Sort by newest
            allProducts.sort((a, b) => {
                const ta = a.data.createdAt?.seconds || 0;
                const tb = b.data.createdAt?.seconds || 0;
                return tb - ta;
            });

            renderProducts();

        } catch (err) {
            console.error('Kosa la kupakia bidhaa:', err);
            body.innerHTML = `
                <div class="table-empty">
                    <span class="icon">⚠️</span>
                    <h3>Imeshindikana kupakia bidhaa</h3>
                    <p>${escapeHtml(err.message)}</p>
                </div>
            `;
        }
    }

    // ===== SEARCH =====
    document.getElementById('searchInput').addEventListener('input', (e) => {
        currentSearch = e.target.value.trim();
        renderProducts();
    });

    // ===== FILTER CHIPS =====
    document.querySelectorAll('.filter-chip').forEach(chip => {
        chip.addEventListener('click', () => {
            document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
            chip.classList.add('active');
            currentFilter = chip.dataset.filter;
            renderProducts();
        });
    });

    // ===== MODAL OPEN/CLOSE =====
    window.openAddModal = function () {
        document.getElementById('modalTitle').textContent = 'Ongeza Bidhaa';
        document.getElementById('productForm').reset();
        document.getElementById('productId').value = '';
        clearErrors();
        document.getElementById('productModal').classList.add('show');
    };

    window.openEditModal = function (id) {
        const item = allProducts.find(p => p.id === id);
        if (!item) return;

        const p = item.data;
        document.getElementById('modalTitle').textContent = 'Badilisha Bidhaa';
        document.getElementById('productId').value = id;
        document.getElementById('fName').value = p.name || '';
        document.getElementById('fCategory').value = p.category || '';
        document.getElementById('fPrice').value = p.price || '';
        document.getElementById('fOldPrice').value = p.oldPrice || '';
        document.getElementById('fStock').value = p.stock || '';
        document.getElementById('fImage').value = p.image || '';
        document.getElementById('fSizes').value = Array.isArray(p.sizes) ? p.sizes.join(',') : '';
        document.getElementById('fColors').value = Array.isArray(p.colors)
            ? p.colors.map(c => c.name || c).join(',')
            : '';
        document.getElementById('fDescription').value = p.description || '';
        document.getElementById('fBadge').value = p.badge || '';
        document.getElementById('fRating').value = p.rating || '';

        clearErrors();
        document.getElementById('productModal').classList.add('show');
    };

    window.closeModal = function () {
        document.getElementById('productModal').classList.remove('show');
    };

    window.openDeleteModal = function (id) {
        const item = allProducts.find(p => p.id === id);
        if (!item) return;
        deleteTargetId = id;
        document.getElementById('deleteMsg').innerHTML =
            `Una uhakika unataka kufuta <strong>"${escapeHtml(item.data.name || 'bidhaa')}"</strong>? Kitendo hiki hakiwezi kurudishwa.`;
        document.getElementById('deleteModal').classList.add('show');
    };

    window.closeDeleteModal = function () {
        document.getElementById('deleteModal').classList.remove('show');
        deleteTargetId = null;
    };

    // ===== VALIDATION =====
    function clearErrors() {
        document.querySelectorAll('#productForm .form-group').forEach(g => g.classList.remove('error'));
    }

    function setError(id) {
        const g = document.getElementById(id);
        if (g) g.classList.add('error');
    }

    function validateForm() {
        clearErrors();
        let valid = true;

        const name = document.getElementById('fName').value.trim();
        const category = document.getElementById('fCategory').value;
        const price = document.getElementById('fPrice').value;
        const stock = document.getElementById('fStock').value;

        if (!name) { setError('fNameGroup'); valid = false; }
        if (!category) { setError('fCategoryGroup'); valid = false; }
        if (!price || Number(price) <= 0) { setError('fPriceGroup'); valid = false; }
        if (stock === '' || Number(stock) < 0) { setError('fStockGroup'); valid = false; }

        return valid;
    }

    // Clear errors on input
    ['fName','fCategory','fPrice','fStock'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener('input', () => {
                const g = el.closest('.form-group');
                if (g) g.classList.remove('error');
            });
            el.addEventListener('change', () => {
                const g = el.closest('.form-group');
                if (g) g.classList.remove('error');
            });
        }
    });

    // ===== SAVE =====
    window.saveProduct = async function () {
        if (!validateForm()) {
            showToast('⚠️ Tafadhali jaza sehemu zinazohitajika', 'error');
            return;
        }

        const btn = document.getElementById('saveBtn');
        btn.disabled = true;
        btn.textContent = '⏳ Inahifadhi...';

        const id = document.getElementById('productId').value;

        // Parse sizes & colors
        const sizesRaw = document.getElementById('fSizes').value.trim();
        const colorsRaw = document.getElementById('fColors').value.trim();

        const sizes = sizesRaw
            ? sizesRaw.split(',').map(s => s.trim()).filter(Boolean)
            : [];

        const colors = colorsRaw
            ? colorsRaw.split(',').map(c => ({ name: c.trim(), hex: '#888888' })).filter(c => c.name)
            : [];

        const data = {
            name: document.getElementById('fName').value.trim(),
            category: document.getElementById('fCategory').value,
            price: Number(document.getElementById('fPrice').value) || 0,
            oldPrice: Number(document.getElementById('fOldPrice').value) || 0,
            stock: Number(document.getElementById('fStock').value) || 0,
            image: document.getElementById('fImage').value.trim(),
            sizes,
            colors,
            description: document.getElementById('fDescription').value.trim(),
            badge: document.getElementById('fBadge').value || '',
            rating: Number(document.getElementById('fRating').value) || 0,
            updatedAt: serverTimestamp()
        };

        try {
            if (id) {
                await updateDoc(doc(db, 'products', id), data);
                showToast('✅ Bidhaa imebadilishwa kikamilifu', 'success');
            } else {
                data.createdAt = serverTimestamp();
                await addDoc(collection(db, 'products'), data);
                showToast('✅ Bidhaa mpya imeongezwa', 'success');
            }

            closeModal();
            await loadProducts();

        } catch (err) {
            console.error('Kosa la kuhifadhi:', err);
            showToast('❌ Imeshindikana kuhifadhi: ' + err.message, 'error');
        } finally {
            btn.disabled = false;
            btn.textContent = '💾 Hifadhi';
        }
    };

    // ===== DELETE =====
    window.confirmDelete = async function () {
        if (!deleteTargetId) return;

        const btn = document.getElementById('confirmDeleteBtn');
        btn.disabled = true;
        btn.textContent = '⏳ Inafuta...';

        try {
            await deleteDoc(doc(db, 'products', deleteTargetId));
            showToast('🗑️ Bidhaa imefutwa', 'success');
            closeDeleteModal();
            await loadProducts();
        } catch (err) {
            console.error('Kosa la kufuta:', err);
            showToast('❌ Imeshindikana kufuta: ' + err.message, 'error');
        } finally {
            btn.disabled = false;
            btn.textContent = 'Ndiyo, Futa';
        }
    };

    // ===== INIT =====
    loadProducts();
</script>

<%- include('../partials/footer') %>
